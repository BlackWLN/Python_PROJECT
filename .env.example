# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
# Option A: individual fields (used for local development)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=questiondb
POSTGRES_PORT=5432

# Option B: single connection string (used by Render/Neon/Supabase/Railway).
# If set, this takes priority over the fields above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
BACKEND_CORS_ORIGINS=http://localhost:8501
